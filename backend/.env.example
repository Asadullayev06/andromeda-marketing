# ANDROMEDA Sales backend — copy to backend/.env and fill in.
#
# Use the SAME values as ANDROMEDA (custom_control/backend/.env) for these two,
# so the shared user roster and sessions interoperate:
#
#   1. DATABASE_URL  — the shared PostgreSQL. Ideally a READ-mostly role.
#   2. AUTH_SECRET_KEY — MUST match ANDROMEDA's AUTH_SECRET_KEY exactly.
#
# This service NEVER runs migrations. ANDROMEDA owns the schema.

DATABASE_URL=postgresql://user:password@host:5432/dbname

AUTH_SECRET_KEY=must-match-andromeda-auth-secret-key

# Comma-separated origins allowed to call this API (the Sales frontend).
CORS_ORIGINS=http://localhost:5175,http://localhost:5173

ENV=development
